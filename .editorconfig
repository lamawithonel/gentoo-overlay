root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Gentoo ebuilds and eclasses indent with tabs (devmanual).
[*.{ebuild,eclass}]
indent_style = tab
indent_size = 4

# Profile files keep hard tabs; several carry a
# `# vi:ts=8:sw=8:noexpandtab` modeline.
[profiles/**]
indent_style = tab
indent_size = 8

# mise file tasks are bash; the shell style guide indents with tabs.
[.config/mise/tasks/*]
indent_style = tab

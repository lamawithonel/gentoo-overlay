root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Gentoo ebuilds and eclasses indent with tabs (devmanual).
[*.{ebuild,eclass}]
indent_style = tab
indent_size = 4

# Profile files use soft tabs at 4-space width.
[profiles/**]
indent_style = space
indent_size = 4

# Except these two, which align their values with hard tabs and
# carry a `# vi:ts=8:sw=8:noexpandtab` modeline.
[profiles/custom/{base,plasma}/make.defaults]
indent_style = tab
indent_size = 8

# mise file tasks are bash; the shell style guide indents with tabs.
[.config/mise/tasks/*]
indent_style = tab

@@ -0,0 +1,267 @@
+"""Tests for setup.py's packaged mode (opt-in, STRATA_STATE_DIR): a distribution installs Strata read-only and points
+STRATA_STATE_DIR at a writable folder, which is home().  The model configs, settings.json and the default data folder go
+there; setup never runs pip, downloads or compiles an engine, a reader or llama.cpp, and writes no start script.  No GPU, no downloads.
+
+    python -m pytest tools/test_setup_packaged.py
+"""
+from __future__ import annotations
+
+import argparse
+import contextlib
+import io
+import json
+import os
+import shutil
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+sys.path.insert(0, str(ROOT / "tools"))
+import setup  # noqa: E402
+
+
+class Args(argparse.Namespace):
+    """setup's parsed arguments: an option not set here was not given."""
+    def __getattr__(self, name):
+        return None
+
+
+def build_json(folder: Path, **meta) -> None:
+    """The package's engine/strata and the engine/BUILD.json it writes beside it."""
+    eng = folder / "engine"
+    eng.mkdir(parents=True)
+    (eng / setup.EXE).write_bytes(b"")
+    (eng / "BUILD.json").write_text(json.dumps({"backend": "hip", "archs": ["gfx1100"], "isa_floor": "avx",
+                                                "version": "0.2.13", **meta}), encoding="utf-8")
+
+
+def files(folder: Path) -> set:
+    return {p.relative_to(folder) for p in folder.rglob("*")}
+
+
+def patch(test: unittest.TestCase, *patches) -> None:
+    for p in patches:
+        p.start()
+        test.addCleanup(p.stop)
+
+
+class Packaged(unittest.TestCase):
+    """Given packaged mode: a read-only install (ROOT) and its state folder (STATE_DIR), both temporary."""
+    def setUp(self):
+        self.tmp = Path(tempfile.mkdtemp(prefix="strata-packaged-"))
+        self.addCleanup(shutil.rmtree, self.tmp, True)
+        self.root, self.state = self.tmp / "usr-lib-strata", self.tmp / "state"
+        self.root.mkdir()
+        self.state.mkdir()
+        patch(self, mock.patch.object(setup, "ROOT", self.root),
+              mock.patch.object(setup, "STATE_DIR", self.state, create=True))
+
+
+class SwitchTest(unittest.TestCase):
+    def test_given_strata_state_dir_when_setup_loads_then_packaged_mode_is_on(self):
+        env = dict(os.environ, STRATA_STATE_DIR="/var/lib/strata")
+        on = subprocess.run([sys.executable, "-c", "import setup; print(setup.STATE_DIR)"], cwd=ROOT, env=env,
+                            capture_output=True, text=True)
+        self.assertEqual(on.stdout.strip(), "/var/lib/strata", on.stderr)
+        env.pop("STRATA_STATE_DIR")
+        off = subprocess.run([sys.executable, "-c", "import setup; print(setup.STATE_DIR)"], cwd=ROOT, env=env,
+                             capture_output=True, text=True)
+        self.assertEqual(off.stdout.strip(), "None", off.stderr)
+
+
+class InstallTest(Packaged):
+    def test_given_packaged_mode_when_setup_installs_then_its_files_are_under_the_state_dir_only(self):
+        key = next(iter(setup.OWN_PATH_FAMILIES))
+        fam = setup.OWN_PATH_FAMILIES[key]
+        model = next(iter(fam["models"]))
+        tag = fam["tag"] + model
+        gguf_dir = self.tmp / "gguf"
+        gguf_dir.mkdir()
+        (gguf_dir / fam["file"].format(q=model)).write_bytes(b"")
+        tok = self.state / "data" / "packs" / tag.lower() / "tokenizer"
+        tok.mkdir(parents=True)
+        (tok / "vocab.json").write_text("{}", encoding="utf-8")
+        (self.tmp / "venv").mkdir()
+        before = files(self.root)
+        runs = []
+        gpu = {"index": 0, "count": 1, "arch": "gfx1100", "name": "Radeon", "vram_gb": 24.0}
+        eng = self.root / "engine"
+        a = Args(model=model, context=32768, yes=True, no_start=True, gguf_dir=str(gguf_dir))
+        with mock.patch.object(setup, "engine_step", lambda *x: (self.root / "third_party" / "llama.cpp", eng, {}, [],
+                                                                 gpu, "none")), \
+                mock.patch.object(setup, "engine_families", lambda e: {fam["arch"]}), \
+                mock.patch.object(setup, "own_path_vision", lambda *x: "none"), \
+                mock.patch.object(setup, "done", lambda p: True), \
+                mock.patch.object(setup, "verify_sha256", lambda *x, **k: None), \
+                mock.patch.object(setup, "recommend_pool_workers", lambda args: args), \
+                mock.patch.object(setup, "run", lambda cmd, **k: runs.append(cmd)), \
+                mock.patch.object(sys, "prefix", str(self.tmp / "venv")), \
+                contextlib.redirect_stdout(io.StringIO()):
+            rc = setup.install_own_path(a, key, gpu, True, [], 13, False, 8095, 1000.0, None)
+        self.assertEqual(rc, 0)
+        self.assertEqual(files(self.root), before, "nothing is written into the read-only install")
+        cfg = json.loads((self.state / f"strata-{tag.lower()}.json").read_text(encoding="utf-8"))
+        self.assertNotIn("log", cfg, "no log file: the engine writes to the server's stderr (the journal)")
+        self.assertEqual(cfg["cwd"], str(self.state))
+        self.assertEqual(cfg["port"], 8095)
+        self.assertEqual(setup.settings_path(), self.state / "settings.json")
+        self.assertTrue((self.state / "settings.json").is_file())
+        self.assertEqual(sorted(self.state.glob("run-*")), [])
+        self.assertEqual([c for c in runs if "pip" in c], [])
+
+
+class PipTest(Packaged):
+    def test_given_packaged_mode_when_setup_checks_python_packages_then_it_never_runs_pip(self):
+        runs = []
+        (self.tmp / "venv").mkdir()
+        with mock.patch.object(setup, "run", lambda cmd, **k: runs.append(cmd)), \
+                mock.patch.object(sys, "prefix", str(self.tmp / "venv")), contextlib.redirect_stdout(io.StringIO()):
+            setup.pip_install(["numpy==2.5.3"], "numpy")
+        self.assertEqual(runs, [])
+
+
+class EngineTest(Packaged):
+    """Given packaged mode and the package's engine/BUILD.json: nothing is downloaded or compiled."""
+    def setUp(self):
+        super().setUp()
+        for name in ("download", "build_engine", "build_engine_hip", "get_prebuilt", "get_prebuilt_hip", "cmake_build",
+                     "run"):
+            patch(self, mock.patch.object(setup, name, mock.Mock(side_effect=AssertionError(f"setup ran {name}"))))
+        self.cpu("avx")
+
+    def cpu(self, floor: str) -> None:
+        patch(self, mock.patch.object(setup, "cpu_info", lambda: ("cpu", floor == "")),
+              mock.patch.object(setup, "cpu_floor", lambda avx2: floor))
+
+    def step(self, arch="gfx1100", vision="none"):
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            try:
+                r = setup.engine_step(Args(), {"index": 0, "count": 1, "arch": arch, "name": "Radeon"}, True, [], 13,
+                                      vision)
+            except SystemExit:
+                return None, out.getvalue()
+        return r, out.getvalue()
+
+    def test_given_a_build_for_this_pc_when_setup_runs_then_it_uses_the_packaged_engine(self):
+        build_json(self.root)
+        r, out = self.step()
+        self.assertIsNotNone(r, out)
+        self.assertEqual(r[1], self.root / "engine")
+        self.assertEqual(r[3], [])
+
+    def test_given_a_card_the_build_lacks_when_setup_runs_then_it_stops_with_the_amdgpu_targets_hint(self):
+        build_json(self.root)
+        r, out = self.step("gfx1201")
+        self.assertIsNone(r)
+        self.assertIn("gfx1201", out)
+        self.assertIn("AMDGPU_TARGETS", out)
+
+    def test_given_an_avx2_build_on_an_avx_cpu_when_setup_runs_then_it_stops_with_the_cpu_flags_hint(self):
+        build_json(self.root, isa_floor="portable")
+        r, out = self.step()
+        self.assertIsNone(r)
+        self.assertIn("CPU_FLAGS_X86", out)
+
+    def test_given_a_no_avx_build_on_an_avx2_cpu_when_setup_runs_then_it_runs(self):
+        build_json(self.root, isa_floor="none")
+        self.cpu("")
+        r, out = self.step()
+        self.assertIsNotNone(r, out)
+
+
+    def test_given_the_package_has_a_gpu_reader_when_setup_runs_then_the_reader_choice_is_kept(self):
+        build_json(self.root, vision="gpu", vision_gpu="strata-vision-hip", vision_cpu="strata-vision")
+        for name in ("strata-vision-hip", "strata-vision"):
+            (self.root / "engine" / name).write_bytes(b"")
+        r, out = self.step(vision="gpu")
+        self.assertIsNotNone(r, out)
+        self.assertEqual(r[5], "gpu")
+
+    def test_given_no_reader_beside_the_engine_when_setup_asks_for_images_then_they_are_off(self):
+        build_json(self.root)
+        r, out = self.step(vision="gpu")
+        self.assertIsNotNone(r, out)
+        self.assertEqual(r[5], "none")
+
+    def test_given_packaged_mode_when_setup_needs_llama_cpp_then_it_is_the_installed_one_and_nothing_is_fetched(self):
+        self.assertEqual(setup.get_llama_cpp(), self.root / "third_party" / "llama.cpp")
+        self.assertEqual(files(self.root), set())
+
+    def test_given_packaged_mode_then_an_installed_engine_is_never_updated(self):
+        setup.update_installed_engine("https://example.invalid/")
+
+    def test_given_packaged_mode_when_a_model_needs_its_shape_engine_then_setup_stops_without_fetching_it(self):
+        build_json(self.root)
+        patch(self, mock.patch.object(setup, "shape_engine_fetch", mock.Mock(side_effect=AssertionError("fetched"))),
+              mock.patch.dict(setup.SHAPE_ENGINE, {"shape": "q4_lite", "title": "Qwen4-Lite"}))
+        r, out = self.step()
+        self.assertIsNone(r)
+        self.assertIn("Qwen4-Lite", out)
+        self.assertIn("packaged", out)
+
+    def test_given_packaged_mode_when_deepseek_is_chosen_then_setup_stops_before_anything_else(self):
+        patch(self, mock.patch.object(setup, "get_dsv41_engine", mock.Mock(side_effect=AssertionError("fetched"))))
+        out = io.StringIO()
+        gpu = {"index": 0, "count": 1, "arch": "gfx1100", "name": "Radeon", "vram_gb": 24.0}
+        with contextlib.redirect_stdout(out), self.assertRaises(SystemExit):
+            setup.install_dsv41(Args(yes=True), "deepseek41", gpu, True, [], 13, False, 8095, 1000.0, None, [gpu])
+        self.assertIn("DeepSeek", out.getvalue())
+        self.assertIn("packaged", out.getvalue())
+        self.assertEqual(files(self.root), set())
+        self.assertEqual(files(self.state), set())
+
+
+class HomeTest(Packaged):
+    def test_given_packaged_mode_then_home_is_the_state_dir_not_the_read_only_install(self):
+        self.assertEqual(setup.home(), self.state)
+
+
+class DataTest(Packaged):
+    def test_given_packaged_mode_then_the_data_dir_is_state_data_and_other_copies_are_left_alone(self):
+        old = self.tmp / "Strata-old"
+        (old / "models").mkdir(parents=True)
+        (old / "setup.py").write_text("", encoding="utf-8")
+        (old / "models" / "m.gguf").write_bytes(b"x")
+        with contextlib.redirect_stdout(io.StringIO()):
+            dest, elsewhere = setup.data_folder(None)
+        self.assertEqual(dest, self.state / "data")
+        self.assertEqual(elsewhere, [])
+        self.assertEqual(setup.other_installs({"installs": [str(old)]}), [])
+        self.assertTrue((old / "models" / "m.gguf").is_file())
+
+
+
+
+class ScriptTest(Packaged):
+    def test_given_packaged_mode_when_setup_finishes_then_it_writes_no_run_script(self):
+        self.assertIsNone(setup.write_run_script("Q4", self.state / "strata-q4.json", 8095))
+        self.assertEqual(files(self.root), set())
+        self.assertEqual(files(self.state), set())
+
+
+class PortTest(unittest.TestCase):
+    def test_given_packaged_mode_and_no_port_then_a_new_install_gets_8095(self):
+        with mock.patch.object(setup, "STATE_DIR", Path("/var/lib/strata"), create=True):
+            self.assertEqual(setup.new_install_port(), 8095)
+
+    def test_given_no_packaged_mode_then_a_new_install_keeps_8080(self):
+        with mock.patch.object(setup, "STATE_DIR", None, create=True):

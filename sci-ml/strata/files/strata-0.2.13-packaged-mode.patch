@@ -0,0 +1,111 @@
+"""Tests for the server's packaged mode (STRATA_STATE_DIR set, as for setup.py): the config's "port" when no --port is
+given, and an engine whose config names no "log" writing to the server's stderr (a service's journal).  No GPU.
+
+    python -m pytest serve/test_packaged.py
+"""
+from __future__ import annotations
+
+import json
+import os
+import queue
+import shutil
+import socket
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+import unittest
+from pathlib import Path
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT))
+from serve import server  # noqa: E402
+
+
+def free_port() -> int:
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+def ready_line(config: Path, packaged: bool) -> str:
+    """The server's "ready:" line (mock engine, this config, no --port), or all it printed instead."""
+    env = dict(os.environ)
+    env.pop("STRATA_STATE_DIR", None)
+    if packaged:
+        env["STRATA_STATE_DIR"] = str(config.parent)
+    p = subprocess.Popen([sys.executable, str(ROOT / "serve" / "server.py"), "--engine", "mock", "--config",
+                          str(config)], cwd=config.parent, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                         text=True)
+    lines: queue.Queue = queue.Queue()
+    threading.Thread(target=lambda: [lines.put(x) for x in p.stdout], daemon=True).start()
+    seen = []
+    try:
+        deadline = time.monotonic() + 60
+        while time.monotonic() < deadline:
+            try:
+                line = lines.get(timeout=1)
+            except queue.Empty:
+                if p.poll() is not None:
+                    break
+                continue
+            seen.append(line)
+            if line.startswith("ready:"):
+                return line
+        return "".join(seen)
+    finally:
+        p.kill()
+        p.wait()
+
+
+class PortTest(unittest.TestCase):
+    def config(self, **cfg) -> Path:
+        d = Path(tempfile.mkdtemp(prefix="strata-packaged-"))
+        self.addCleanup(shutil.rmtree, d, True)
+        (d / "strata-test.json").write_text(json.dumps(cfg), encoding="utf-8")
+        return d / "strata-test.json"
+
+    def listen_port(self, packaged: bool, cfg: dict) -> int:
+        """The port the server would listen on with no --port; nothing listens (8095 may be taken)."""
+        with mock.patch.object(server, "PACKAGED", packaged, create=True):
+            return server.listen_port(None, cfg)
+
+    def test_given_packaged_mode_and_no_port_when_the_server_starts_then_it_listens_on_the_configs_port(self):
+        port = free_port()                              # ephemeral: here listening is the point
+        self.assertIn(f":{port}/v1", ready_line(self.config(port=port), packaged=True))
+
+    def test_given_packaged_mode_and_a_config_without_port_then_the_old_default_stands(self):
+        self.assertEqual(self.listen_port(True, {}), 8095)
+
+    def test_given_no_packaged_mode_then_the_configs_port_is_ignored_as_before(self):
+        self.assertEqual(self.listen_port(False, {"port": free_port()}), 8095)
+
+
+class EngineLogTest(unittest.TestCase):
+    def engine_stderr(self, packaged: bool):
+        """The stderr the engine process is started with, for a config without "log"."""
+        seen = {}
+
+        class Started(Exception):
+            pass
+
+        def popen(what, cmd, **kw):
+            seen.update(kw)
+            raise Started
+
+        with mock.patch.object(server, "PACKAGED", packaged, create=True), mock.patch.object(server, "popen", popen):
+            with self.assertRaises(Started):
+                server.StrataEngine("missing-executable", [], log=None)
+        return seen["stderr"]
+
+    def test_given_packaged_mode_and_no_log_when_the_engine_starts_then_its_stderr_is_the_servers(self):
+        self.assertIsNone(self.engine_stderr(True))
+
+    def test_given_no_packaged_mode_and_no_log_then_the_engines_stderr_is_dropped_as_before(self):
+        self.assertIs(self.engine_stderr(False), subprocess.DEVNULL)
+
+
+if __name__ == "__main__":
+    unittest.main()
